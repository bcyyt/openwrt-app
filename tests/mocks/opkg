#!/bin/sh
DB="${STATEFUL_ROOT}/var/opkg"
mkdir -p "$DB"
INST="$DB/installed"
[ -f "$INST" ] || touch "$INST"

cmd="${1:-}"
[ -n "$cmd" ] && shift

case "$cmd" in
	list-installed)
		cat "$INST"
		;;
	install)
		pkg="$1"
		if [ -s "$DB/fail_install" ]; then
			echo "opkg: install failed" >&2
			exit 1
		fi
		if grep -q "^${pkg} - " "$INST" 2>/dev/null; then
			exit 0
		fi
		printf '%s - 1.0\n' "$pkg" >> "$INST"
		;;
	remove)
		pkg="$1"
		if grep -q "^${pkg} - " "$INST" 2>/dev/null; then
			grep -v "^${pkg} - " "$INST" > "$INST.new" || true
			mv "$INST.new" "$INST"
		fi
		;;
	status)
		pkg="$1"
		printf 'Package: %s\n' "$pkg"
		case "$pkg" in
			busybox|base-files|luci-base|dropbear|luci)
				printf 'Essential: yes\n'
				;;
		esac
		;;
	update)
		if [ -s "$DB/fail_update" ]; then
			echo "opkg: update failed" >&2
			exit 1
		fi
		exit 0
		;;
	*)
		exit 0
		;;
esac
